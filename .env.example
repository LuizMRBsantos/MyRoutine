# ================================
# App
# ================================
APP_ENV=development
APP_PORT=8080
APP_NAME=myroutine

# ================================
# Database (PostgreSQL)
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=myroutine
DB_PASSWORD=changeme_in_production
DB_NAME=myroutine_db
DB_SSLMODE=disable
DATABASE_URL=postgres://myroutine:changeme_in_production@localhost:5432/myroutine_db?sslmode=disable

# ================================
# Redis
# ================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ================================
# JWT
# ================================
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ================================
# Claude AI (Anthropic)
# ================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ================================
# CORS
# ================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ================================
# ADMIN (convites)
# ================================
# Cadastro é só por convite. Os e-mails desta lista (separados por vírgula)
# podem criar conta sem convite e viram administradores, que geram os links
# de convite no app. Obrigatório para o primeiro acesso num banco vazio.
ADMIN_EMAILS=seu-email@exemplo.com

# ================================
# IP DO CLIENTE E LIMITE DE TENTATIVAS
# ================================
# Cabeçalho com o IP real, definido pelo proxy na frente da API:
# X-Real-IP (nginx, local) ou CloudFront-Viewer-Address (AWS). Só é seguro
# se NADA além desse proxy alcançar a API.
TRUSTED_IP_HEADER=X-Real-IP
# Tentativas por minuto, por IP, nas rotas de login/cadastro/sessão.
AUTH_RATE_LIMIT_PER_MINUTE=10

# ================================
# BANCO E MIGRAÇÕES (servidor vs. serverless)
# ================================
# Local/Docker: aplica as migrações ao subir e mantém um pool grande.
# Vercel: RUN_MIGRATIONS=false (o CI aplica antes do deploy) e DB_MAX_CONNS=3,
# com DATABASE_URL apontando para o pooler do Supabase (porta 6543) e
# "?sslmode=require&default_query_exec_mode=simple_protocol".
RUN_MIGRATIONS=true
DB_MAX_CONNS=25

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
